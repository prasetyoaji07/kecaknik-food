# Salin menjadi .env lalu isi. Jangan pernah meng-commit .env.
PORT=5000

# Akun admin tunggal
ADMIN_PASSWORD=ganti-dengan-sandi-kuat
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=8h

# MySQL / MariaDB (XAMPP bawaan: user root, tanpa sandi)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kecaknik_food

# Asal yang diizinkan CORS (customer-app dan admin-app)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
